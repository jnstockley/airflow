{
  "extends": [
    "config:recommended"
  ],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "beta"
  ],
  "assignees": [
    "jnstockley"
  ],
  "prConcurrentLimit": 0,
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements(_.*)?.txt$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Airflow version against the tags actually published in the hardened dhi.io/airflow registry.",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG AIRFLOW_VERSION=(?<currentValue>[^\\s]+)\\s"
      ],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://dhi.io",
      "packageNameTemplate": "airflow",
      "depNameTemplate": "apache/airflow",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)-python"
    },
    {
      "customType": "regex",
      "description": "Track the Python version against the tags actually published in the hardened dhi.io/airflow registry.",
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://dhi.io",
      "packageNameTemplate": "airflow",
      "depNameTemplate": "python",
      "versioningTemplate": "python",
      "extractVersionTemplate": "-python(?<version>\\d+\\.\\d+)-",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^\\.python-version$/"
      ],
      "matchStrings": [
        "ARG PYTHON_VERSION=(?<currentValue>\\d+\\.\\d+)\\s",
        "^(?<currentValue>\\d+\\.\\d+)\\s*$"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["pyenv"],
      "enabled": false
    },
    {
      "description": "The built-in dockerfile/docker manager can't parse the composite FROM tag (multiple ARGs + suffix), so let the two custom managers above be the sole source of truth for this image.",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["dhi.io/airflow", "airflow"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchDepNames": ["apache/airflow"],
      "semanticCommitType": "minor",
      "semanticCommitScope": "airflow"
    },
    {
      "matchDatasources": ["docker"],
      "matchDepNames": ["python"],
      "groupName": "Python",
      "groupSlug": "python",
      "semanticCommitType": "minor",
      "semanticCommitScope": "python_minor"
    }
  ]
}
